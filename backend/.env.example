# OAuth2.0 Configuration for Backend

# GitHub OAuth (for repository access)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitLab OAuth (for repository access)
GITLAB_CLIENT_ID=your_gitlab_client_id
GITLAB_CLIENT_SECRET=your_gitlab_client_secret

# OAuth Redirect URI (where OAuth providers will redirect after authentication)
OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# Google OAuth (for user authentication)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# JWT Configuration
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_ISSUER=opscore
JWT_EXPIRATION_HOURS=24

# Database Configuration
DATABASE_URL=postgres://opscore_user:opscore_password@db:5432/opscore_db?sslmode=disable

# Encryption Key (for storing sensitive data)
ENCRYPTION_KEY=your-32-character-encryption-key

# Logging
LOG_LEVEL=INFO
