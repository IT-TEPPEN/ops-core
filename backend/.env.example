# OAuth2.0 Configuration for Backend

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitLab OAuth
GITLAB_CLIENT_ID=your_gitlab_client_id
GITLAB_CLIENT_SECRET=your_gitlab_client_secret

# OAuth Redirect URI (where OAuth providers will redirect after authentication)
OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# Database Configuration
DATABASE_URL=postgres://opscore_user:opscore_password@db:5432/opscore_db?sslmode=disable

# Encryption Key (for storing sensitive data)
ENCRYPTION_KEY=your-32-character-encryption-key

# Logging
LOG_LEVEL=INFO
