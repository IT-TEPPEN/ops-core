# Database Configuration
DATABASE_URL=postgres://opscore_user:opscore_password@db:5432/opscore_db?sslmode=disable

# Cache Configuration
# Cache type: "memory" or "redis"
CACHE_TYPE=memory

# Cache TTL settings (in seconds)
CACHE_TTL_DOCUMENT=3600        # 1 hour
CACHE_TTL_DOCUMENT_VERSION=10800  # 3 hours
CACHE_TTL_STATISTICS=1800      # 30 minutes
CACHE_TTL_USER=7200           # 2 hours
CACHE_TTL_GROUP=7200          # 2 hours

# Redis Configuration (only required if CACHE_TYPE=redis)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_TLS=false

# Pagination Configuration
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
CURSOR_PAGINATION_ENABLED=true

# Server Configuration
PORT=8080

# Frontend Configuration (for Vite)
VITE_API_HOST=localhost:8080
